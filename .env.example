# --- Admin panel (required to use /admin) ---
ADMIN_PASSWORD=change-this-long-password
# Optional separate signing secret for the admin cookie (defaults to ADMIN_PASSWORD)
AUTH_SECRET=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://www.hariramsabooschool.com

# --- Storage ---
# Default: JSON files in ./data/store (works on a VPS or EC2 with a persistent disk).
# DATA_DIR=/var/lib/sps-data
# For Vercel or any read-only host use Supabase (see README for the SQL):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: forward every new enquiry to a webhook (Zapier, Make, n8n, your CRM) ---
# ENQUIRY_WEBHOOK_URL=
